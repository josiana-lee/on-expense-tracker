<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 이 줄은 사실이지만, 넣은 이유였던 문제는 못 고쳤다.

         12번 업로드에서 "이전 버전에서 지원하던 기기 26개(태블릿 6·TV 3·
         차량 17, 전화는 0)를 더 이상 지원하지 않는다"는 오류가 났다. 그때
         새로 들어온 것이 @capacitor/haptics가 자기 매니페스트로 들여오는
         VIBRATE뿐이라, Play가 그걸 진동기 필수로 읽는 것으로 보고 이 줄을
         넣어 13번을 올렸다. **기기 수는 똑같이 26대였다.** 그러니 원인은
         VIBRATE가 아니다. 짐작으로 다시 고치지 말고, Play Console의 지원
         기기 변경사항에서 행별 화살표를 눌러 빠진 기기 목록을 먼저 봐라.

         그래도 남겨두는 건 선언 자체가 맞는 말이기 때문이다 — tapFeedback()은
         실패를 삼키고 설정에 끄는 스위치도 있어서, 진동기가 없는 기기에서도
         앱은 그대로 돌아간다. 권한은 빼면 안 된다: 진동기가 있는 기기에서는
         여전히 필요하다. -->
    <uses-feature android:name="android.hardware.vibrator" android:required="false" />
</manifest>
